# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   set -a; source .env; set +a
#   ./gradlew :backend:run

# --- Volvo developer portal ---
# From https://developer.volvocars.com/ → your application.
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
VOLVO_VCC_API_KEY=

# Must match a redirect URI registered on the developer portal.
VOLVO_REDIRECT_URI=http://localhost:8080/auth/callback

# --- Local Postgres (docker-compose) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/chargebook
DATABASE_USER=chargebook
DATABASE_PASSWORD=chargebook
